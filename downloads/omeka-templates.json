    "required": false,
    "data_type": "resource:item",
    "note": "출생지·활동지"
   },
   {
    "term": "rico:isOrWasSubjectOf",
    "label": "주제인 기록",
    "required": false,
    "data_type": "resource:item",
    "note": "이 인물을 다룬 기록"
   },
   {
    "term": "rico:identifier",
    "label": "식별기호",
    "required": true,
    "data_type": "literal",
    "note": "기관 고유 ID"
   },
   {
    "term": "owl:sameAs",
    "label": "동일 개체",
    "required": false,
    "data_type": "uri",
